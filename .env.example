# ==============================================================================
# COGNIVANTA PLATFORM CONFIGURATION TEMPLATE
# Copy this file to .env and configure local environment settings.
# DO NOT COMMIT REAL CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Web Client URL
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_WS_URL=ws://localhost:3000/ws

# Database Configuration (PostgreSQL / In-Memory SQLite Fallback)
DATABASE_URL=postgresql://cognivanta_user:placeholder_password@localhost:5432/cognivanta_db
DATABASE_DRIVER=sqlite_memory # Options: sqlite_memory, sqlite_file, postgres
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Cache & Job Queue (Optional - in-memory fallback enabled by default)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Multi-Tenant & Security
JWT_SECRET=demo-dev-jwt-secret-do-not-use-in-production-min-32-chars-long
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=demo-dev-encryption-key-32-bytes-placeholder!
COOKIE_SECRET=demo-dev-cookie-secret-placeholder

# AI Provider Gateway API Keys (Placeholders - Platform runs 100% locally with Mock Provider)
OPENAI_API_KEY=mock-openai-key-dev-placeholder
ANTHROPIC_API_KEY=mock-anthropic-key-dev-placeholder
GEMINI_API_KEY=mock-gemini-key-dev-placeholder
COHERE_API_KEY=mock-cohere-key-dev-placeholder
OLLAMA_BASE_URL=http://localhost:11434

# Default Provider & Model Fallback
DEFAULT_LLM_PROVIDER=mock # Options: mock, openai, anthropic, gemini, ollama
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_EMBEDDING_PROVIDER=mock
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Vector Store Engine
VECTOR_STORE_TYPE=memory # Options: memory, pgvector, chroma, qdrant
CHROMA_URL=http://localhost:8000
QDRANT_URL=http://localhost:6333

# Object Storage / Document Repository
STORAGE_DRIVER=local # Options: local, s3, gcs
STORAGE_LOCAL_PATH=./data/storage
S3_BUCKET=cognivanta-documents-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=mock-s3-access-key
S3_SECRET_ACCESS_KEY=mock-s3-secret-key

# Telemetry & Observability
LOG_LEVEL=info # Options: debug, info, warn, error
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_AUDIT_LOG_CHAINING=true
